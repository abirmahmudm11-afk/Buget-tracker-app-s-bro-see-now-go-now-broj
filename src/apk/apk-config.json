{
  "applicationId": "com.aistudio.spendly.vkmxqr",
  "appName": "Spendly",
  "versionCode": 1,
  "versionName": "1.0",
  "minSdk": 24,
  "targetSdk": 36,
  "packageFormat": "apk",
  "tasks": {
    "debugApk": ":app:assembleDebug",
    "releaseApk": ":app:assembleRelease"
  },
  "outputs": {
    "debug": "app/build/outputs/apk/debug/app-debug.apk",
    "release": "app/build/outputs/apk/release/app-release.apk"
  },
  "features": {
    "googleWallet3DCards": true,
    "photoPickerCardArt": true,
    "cloudFirestoreSync": true
  }
}
